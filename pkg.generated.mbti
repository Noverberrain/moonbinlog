pub fn TableSchema::to_repr(Self) -> @debug.Repr

pub(all) enum TemporalValue {
  Year(Int32)
  Date(year~ : Int32, month~ : Int32, day~ : Int32)
  DateTime(year~ : Int32, month~ : Int32, day~ : Int32, hour~ : Int32, minute~ : Int32, second~ : Int32, microsecond~ : Int32)
  Time(negative~ : Bool, hour~ : Int32, minute~ : Int32, second~ : Int32, microsecond~ : Int32)
  Timestamp(seconds~ : UInt32, microsecond~ : Int32)
} derive(Eq, @debug.Debug)
pub fn TemporalValue::equal(Self, Self) -> Bool
pub fn TemporalValue::not_equal(Self, Self) -> Bool
pub fn TemporalValue::to_repr(Self) -> @debug.Repr

pub(all) enum TransactionAction {
  Begin
  Commit
  Rollback
  Xid(UInt64)
} derive(Eq, @debug.Debug)
pub fn TransactionAction::equal(Self, Self) -> Bool
pub fn TransactionAction::not_equal(Self, Self) -> Bool
pub fn TransactionAction::to_repr(Self) -> @debug.Repr

pub struct TransactionBoundary {
  header : EventHeader
  action : TransactionAction
} derive(Eq, @debug.Debug)
pub fn TransactionBoundary::equal(Self, Self) -> Bool
pub fn TransactionBoundary::not_equal(Self, Self) -> Bool
pub fn TransactionBoundary::parse(FormatDescription, BytesView, file_offset~ : UInt64) -> Self raise DecodeError
pub fn TransactionBoundary::to_repr(Self) -> @debug.Repr

pub struct TransactionDecoder {
  // private fields
}
pub fn TransactionDecoder::feed(Self, BytesView, file_offset~ : UInt64, integer_unsigned? : ReadOnlyArray[Bool?]) -> TransactionStep raise DecodeError
pub fn TransactionDecoder::finish(Self) -> Unit raise DecodeError
pub fn TransactionDecoder::is_active(Self) -> Bool
pub fn TransactionDecoder::new(FormatDescription, max_events? : Int32, max_changes? : Int32, max_bytes? : UInt64) -> Self raise DecodeError

pub(all) enum TransactionOutcome {
  Committed(CommittedTransaction)
  RolledBack(start_offset~ : UInt64, end_offset~ : UInt64, discarded_changes~ : Int32)
} derive(Eq, @debug.Debug)
pub fn TransactionOutcome::equal(Self, Self) -> Bool
pub fn TransactionOutcome::not_equal(Self, Self) -> Bool
pub fn TransactionOutcome::to_repr(Self) -> @debug.Repr

pub struct TransactionStep {
  header : EventHeader
  outcome : TransactionOutcome?
} derive(Eq, @debug.Debug)
pub fn TransactionStep::equal(Self, Self) -> Bool
pub fn TransactionStep::not_equal(Self, Self) -> Bool
pub fn TransactionStep::to_repr(Self) -> @debug.Repr

